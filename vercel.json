{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/calendar-sync",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/recurring-invoices",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/overdue-invoices",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/gmail-sync",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/meet-sync",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/granola-sync",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/scheduled-send",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/outreach-send",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/gsc-sync",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/growth-collect",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/growth-score",
      "schedule": "30 5 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "trailheadholdings.uk" }],
      "destination": "https://www.trailheadholdings.uk/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/((?!api|_next).*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    },
    {
      "source": "/contact",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800" },
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, s-maxage=604800" }
      ]
    }
  ]
}
