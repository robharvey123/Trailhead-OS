NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# OPENAI_API_KEY - no longer used in app, can be removed
# Keep if using OpenAI for other purposes (e.g. VS Code agent)
# OPENAI_API_KEY=
# OPENAI_MODEL - no longer used in app
# OPENAI_MODEL=your-model-here
RESEND_API_KEY=
NOTIFICATION_EMAIL=
NEXT_PUBLIC_APP_URL=
ICAL_SECRET=
# Bearer token for the Cowork REST API and the MCP server (/api/cowork/*, /api/mcp)
COWORK_API_KEY=
# Shared secret every /api/cron/* route checks (Vercel Cron sends it as a Bearer).
CRON_SECRET=
# Web Push (VAPID) — generate once with `npx web-push generate-vapid-keys`.
# Public key is needed at build time (NEXT_PUBLIC_*); private key is server-only.
WEB_PUSH_VAPID_PUBLIC=
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC=
WEB_PUSH_VAPID_PRIVATE=
WEB_PUSH_SUBJECT=mailto:rob@trailheadholdings.uk
# FreeAgent invoice sync (server-only). Register an app at dev.freeagent.com.
# Use the sandbox base URL while testing: https://api.sandbox.freeagent.com/v2
FREEAGENT_CLIENT_ID=
FREEAGENT_CLIENT_SECRET=
FREEAGENT_REDIRECT_URI=https://app.trailheadholdings.uk/api/freeagent/callback
FREEAGENT_BASE_URL=https://api.freeagent.com/v2
RESEND_FROM_EMAIL=Rush Analytics <reports@example.com>
# Outreach campaign engine (Resend). Sending identity + webhook signing secret.
RESEND_WEBHOOK_SECRET=
OUTREACH_FROM_EMAIL=hello@mail.engineeros.uk
OUTREACH_FROM_NAME=Rob Harvey
OUTREACH_REPLY_TO=rob@trailheadholdings.uk
SEED_USER_EMAIL=
